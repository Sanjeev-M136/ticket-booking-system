generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  role      String     @default("CUSTOMER")
  bookings  Booking[]
  waitlists Waitlist[]
}

model Event {
  id            String     @id @default(uuid())
  title         String
  venue         String
  date          String
  time          String
  standardPrice Float
  premiumPrice  Float
  seats         ShowSeat[]
  bookings      Booking[]
  waitlists     Waitlist[]
}

model ShowSeat {
  id            String    @id @default(uuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id])
  seatLabel     String
  category      String
  status        String    @default("AVAILABLE")
  heldByUserId  String?
  holdExpiresAt DateTime?
  bookingId     String?
  booking       Booking?  @relation(fields: [bookingId], references: [id])
}

model Booking {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  eventId          String
  event            Event      @relation(fields: [eventId], references: [id])
  bookingReference String     @unique
  totalAmount      Float
  status           String     @default("CONFIRMED")
  seats            ShowSeat[]
  createdAt        DateTime   @default(now())
}

model Waitlist {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id])
  category       String
  status         String    @default("WAITING")
  offerExpiresAt DateTime?
  offeredSeatId  String?
  createdAt      DateTime  @default(now())
}
